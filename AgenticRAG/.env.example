# Copy this file to ".env" and fill in your real key.
# The .env file is gitignored and must never be committed.

# Groq API key — used for all chat/LLM calls in the notebook.
# Get a free key at https://console.groq.com/keys (keys start with "gsk_").
GROQ_API_KEY=gsk_your_key_here

# Opik (Comet) — LLM observability/tracing for agentic_rag_v3_opik.ipynb.
# Get a key at https://www.comet.com/api/my/settings. Optional unless you run
# the _opik notebook. OPIK_WORKSPACE defaults to "default" if left unset.
OPIK_API_KEY=your_opik_key_here
OPIK_WORKSPACE=your_workspace_name
